PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
MONGODB_DB_NAME=
# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of sites allowed to call the API
FRONTEND_URL=https://epaid.sa,https://www.epaid.sa

# Folder on the server where uploaded images are saved (keep it outside the app folder)
UPLOADS_DIR=/var/www/epaid-uploads
